{
    "name": "feerlied/cmms-dsl",
    "description": "Domain Specific Language para representação de informações de sistemas CMMS.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "antlr/antlr4-php-runtime": "^0.10.0",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "src/Application/",
            "Diagnostic\\": "src/Diagnostic/",
            "Domain\\": "src/Domain/",
            "Infrastructure\\": "src/Infrastructure/",
            "Visitor\\": "src/Visitor/"
        },
        "classmap": [
            "src/Generated/"
        ]
    }
}
