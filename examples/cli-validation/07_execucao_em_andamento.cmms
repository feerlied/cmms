registro execucao_em_andamento_cli {
    equipamento bomba_validacao_cli
    data 11/10/2026-10:30
    origem alarme_pressao_cli
    tempo_execucao 30 minuto
    status em_execucao
    valores {
        pressao 12 bar
        observacao_visual anormal
    }
    relatorio "Diagnostico em andamento"
}
