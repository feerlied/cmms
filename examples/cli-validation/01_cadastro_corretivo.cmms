equipamento bomba_validacao_cli {
    tipo bomba_centrifuga
    servico bombeamento_de_agua
    produto agua
    caracteristicas_processo {
        pressao 10 bar
        vibracao 2.5 mm/s
    }
    variaveis_controladas {
        pressao
        vibracao
        horas_operacao
        observacao_visual
        vazamento
    }
}

manutencao corretiva alarme_pressao_cli {
    equipamento bomba_validacao_cli
    quando pressao maior 12 bar e observacao_visual anormal
    procedimento inspecionar_linha_pressurizada
    prioridade critica
    duracao 2 hora
    prazo 1 dia
    homem_hora 4
}
