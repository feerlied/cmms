equipamento bomba_cr10 {
    tipo: bomba_centrifuga

    servico: bombeamento_de_agua

    produto: agua

    caracteristicas_processo {
        vazao 12 m3/h
        pressao 10 bar
        temperatura 25 celsius
        rotacao 2900 rpm
    }

    variaveis_controladas {
        vazao
        pressao
        vibracao
        temperatura
        horas_operacao
        observacao_visual
        vazamento
    }
}
